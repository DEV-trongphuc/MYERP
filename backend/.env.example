# MYERP Backend Environment Variables Template
# Copy this file to `backend/.env` (and optional overrides to `backend/.env.local`).
# NEVER commit `backend/.env` or `backend/.env.local` to Git.

# --- Database (MySQL 8.0+ / MariaDB 10.6+) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASS=change_me_strong_password
DB_NAME=vhvxoigh_myerp

# --- Authentication (HMAC-SHA256 JWT Secret - minimum 32 random chars) ---
JWT_SECRET=change_me_generate_64_char_random_hex_secret
# JWT_EXPIRE_ACCESS=315360000
# JWT_EXPIRE_REFRESH=315360000

# --- CORS Allowed Origins (comma-separated) ---
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5175

# --- AI Multi-Agent (SI IDEAS) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Environment & Safety Switches ---
APP_ENV=local
DISABLE_ZALO=0
DISABLE_EMAILS=0
# MYERP_TEST_MODE=0

# --- Optional Diagnostic / HTTP Migration Guard (leave empty in production to disable HTTP access) ---
DIAG_TOKEN=
# MYERP_DIAG_TOKEN=

# --- Optional DB Backup / Restore SSH Helper Overrides ---
# BACKUP_SSH_KEY=~/.ssh/id_ed25519
# BACKUP_SSH_USER=
# BACKUP_SSH_HOST=
# BACKUP_SSH_PORT=2210
